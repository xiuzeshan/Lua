        {name = "ZombieHunterOffline", url = "https://files.catbox.moe/wodtan.lua"},
        {name = "NFSNoLimits", url = "https://files.catbox.moe/rfag5t.lua"},
        {name = "DragonBUURRP", url = "https://files.catbox.moe/4yzbcj.lua"},
        {name = "GrimSoul", url = "https://files.catbox.moe/cbei7d.lua"},
        {name = "ARKMobile", url = "https://files.catbox.moe/9uhyqn.lua"},
        {name = "FClassAdventurer", url = "https://files.catbox.moe/fk37j3.lua"},
        {name = "SpaceShooter", url = "https://files.catbox.moe/g78861.lua"},
        {name = "PicklePete", url = "https://files.catbox.moe/hrgq4a.lua"},
        {name = "DBLegends", url = "https://files.catbox.moe/eh7iny.lua"},
        {name = "SquadAngels", url = "https://files.catbox.moe/b8kpuc.lua"},
        {name = "JurassicWorldTheGame", url = "https://files.catbox.moe/3uq20s.lua"},
        {name = "EtherealHunter", url = "https://files.catbox.moe/sc16mb.lua"},
        {name = "CyberFighters", url = "https://files.catbox.moe/iqnqa6.lua"}
    }

    table.sort(files, sortScripts)

    local choices = {}
    for i, file in ipairs(files) do
        table.insert(choices, file.name)
    end
    table.insert(choices, "Download All")

    local selected = gg.multiChoice(choices, nil, "Select script(s) to download (A-Z sorted):")
    
    if not selected then
        gg.alert("No scripts selected!")
        return
    end
    
    local downloaded = {}
    local failed = {}
    local download_locations = {}


    if selected[#choices] then
        for i, file in ipairs(files) do
            local success, result, path = downloadScript(file.url, file.name)
            if success then
                table.insert(downloaded, file.name)
                download_locations[file.name] = path
            else
                table.insert(failed, file.name.." ("..result..")")
            end
        end
    else

        for i = 1, #choices - 1 do
            if selected[i] then
                local file = files[i]
                local success, result, path = downloadScript(file.url, file.name)
                if success then
                    table.insert(downloaded, file.name)
                    download_locations[file.name] = path
                else
                    table.insert(failed, file.name.." ("..result..")")
                end
            end
        end
    end
    
    local location_info = "\n\n📁 Download Locations:\n"
    for name, path in pairs(download_locations) do
        location_info = location_info .. "\n" .. name .. ":\n" .. path .. "\n"
    end
    
    local message = ""
    if #downloaded > 0 then
        message = "✅ Downloaded successfully:\n" .. table.concat(downloaded, "\n")
        message = message .. location_info
    end
    if #failed > 0 then
        if message ~= "" then message = message .. "\n\n" end
        message = message .. "❌ Failed to download:\n" .. table.concat(failed, "\n")
    end
    
    if message ~= "" then
        gg.alert(message)
    else
        gg.alert("No scripts were downloaded!")
    end
end

if not autoUpdate() then
    main()
end
