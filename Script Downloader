local function trim(s)
    return s:gsub("^%s+", ""):gsub("%s+$", "")
end

local function autoUpdate()
    local githubUrl = "https://raw.githubusercontent.com/xiuzeshan/Lua/refs/heads/main/Script%20Downloader"
    local currentScriptPath = gg.getFile()
    
    gg.toast("Checking for updates...", false)
    local response = gg.makeRequest(githubUrl)
    if not response or not response.content then
        return false
    end
    
    local function normalize(content)
        content = content:gsub("\r\n", "\n"):gsub("\r", "\n"):gsub("%s+", " ")
        return trim(content)
    end
    
    local currentFile = io.open(currentScriptPath, "r")
    if currentFile then
        local currentContent = currentFile:read("*a")
        currentFile:close()
        
        if normalize(currentContent) == normalize(response.content) then
            return false
        end
    end
    
    local time = os.date("*t")
    local newFilename = currentScriptPath:gsub(".lua$", "") .. 
                       string.format(" %02d%02d%04d.lua",
                       time.day, time.month, time.year)
    
    local newFile = io.open(newFilename, "w")
    if not newFile then
        gg.toast("Failed to save update", false)
        return false
    end
    
    newFile:write(response.content)
    newFile:close()
    
    local verifyFile = io.open(newFilename, "r")
    if not verifyFile then
        os.remove(newFilename)
        return false
    end
    
    local verifiedContent = verifyFile:read("*a")
    verifyFile:close()
    
    if normalize(verifiedContent) == normalize(response.content) then
        gg.alert("✅ Update successful!\n\nNew script saved as:\n"..
                newFilename.."\n\nPlease run the new file.")
        os.exit()
        return true
    else
        os.remove(newFilename)
        return false
    end
end

local function downloadScript(url, filename)
    gg.toast("Downloading "..filename.."...", false)
    
    local script_path = gg.getFile():match("(.+/)") or ""
    local file_path = script_path .. filename .. "_XIU.lua"
    
    local response = gg.makeRequest(url)
    
    if not response then
        return false, "No response from server", file_path
    elseif response.code and response.code ~= 200 then
        return false, "HTTP Error: "..(response.code or "unknown"), file_path
    elseif not response.content or #response.content == 0 then
        return false, "Empty content received", file_path
    end
    
    local f = io.open(file_path, "w")
    if not f then
        return false, "Failed to create file", file_path
    end
    
    f:write(response.content)
    f:close()
    
    local verify = io.open(file_path, "r")
    if not verify then
        os.remove(file_path)
        return false, "Verification failed", file_path
    end
    
    local content = verify:read("*a")
    verify:close()
    
    if #content ~= #response.content then
        os.remove(file_path)
        return false, "File corrupted during download", file_path
    end
    
    return true, file_path, file_path
end

local function sortScripts(a, b)
    return a.name:upper() < b.name:upper()
end

