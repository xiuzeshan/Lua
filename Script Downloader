local files = {
    {name = "SubwaySurfers", url = "https://files.catbox.moe/ur41lo.lua"},
    {name = "Beatstar", url = "https://files.catbox.moe/j4wszr.lua"}
}

local choices = {}
for i, file in ipairs(files) do
    table.insert(choices, file.name)
end

-- Add "Download All" option as the last item
table.insert(choices, "Download All")

-- Show the multiChoice dialog with English text
local selected = gg.multiChoice(choices, nil, "Select the script(s) you want to download:")

if selected then
    local script_path = gg.getFile():match("(.+/)") -- Get the directory of the currently running script
    local downloaded = {}
    local failed = {}

    -- Check if "Download All" was selected (this is the last element in the choices array)
    if selected[#choices] then
        -- Download all files
        for i, file in ipairs(files) do
            local response = gg.makeRequest(file.url)
            if response and response.content then
                local file_path = script_path .. file.name .. "_XIU.lua"
                local f = io.open(file_path, "w")
                if f then
                    f:write(response.content)
                    f:close()
                    table.insert(downloaded, file_path)
                else
                    table.insert(failed, file.name)
                end
            else
                table.insert(failed, file.name)
            end
        end
    else
        -- Download only selected files (excluding "Download All")
        for i, isSelected in ipairs(selected) do
            if isSelected and i <= #files then -- Only process selections that correspond to files
                local file = files[i]
                local response = gg.makeRequest(file.url)
                if response and response.content then
                    local file_path = script_path .. file.name .. "_XIU.lua"
                    local f = io.open(file_path, "w")
                    if f then
                        f:write(response.content)
                        f:close()
                        table.insert(downloaded, file_path)
                    else
                        table.insert(failed, file.name)
                    end
                else
                    table.insert(failed, file.name)
                end
            end
        end
    end
    
    -- Show results
    local message = ""
    if #downloaded > 0 then
        message = "The following scripts were successfully downloaded:\n" .. table.concat(downloaded, "\n")
    end
    if #failed > 0 then
        if message ~= "" then message = message .. "\n\n" end
        message = message .. "Failed to download the following scripts: " .. table.concat(failed, ", ")
    end
    
    if message ~= "" then
        gg.alert(message)
    else
        gg.alert("No scripts were selected!")
    end
else
    gg.alert("No scripts were selected!")
end
